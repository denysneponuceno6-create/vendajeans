# ============================================================
# Copie para .env (que está no .gitignore) ou defina no Render.
# NUNCA comite valores reais.
# ============================================================

# --- obrigatórios ---
DATABASE_URL=postgres://usuario:senha@localhost:5432/lojajeans
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# --- primeiro acesso ---
ADMIN_USER=admin
ADMIN_PASS=defina-uma-senha-forte-de-10-caracteres-ou-mais

# --- site público autorizado a mandar evento de tracking ---
SITE_ORIGIN=https://sualoja.github.io

# --- ambiente ---
NODE_ENV=development
PORT=3000
SESSION_HOURS=12
DATABASE_SSL=false
RETENCAO_EVENTOS_DIAS=400

# --- migração do sistema antigo ---
LEGADO_DIR=./data

# --- Instagram / Meta (Fase 4 — deixe vazio até ter o app aprovado) ---
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
IG_BUSINESS_ID=

# --- WhatsApp Business Cloud API (Fase 4) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
